# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b

# API Keys (only required for the selected cloud provider)
GOOGLE_API_KEY=
GROQ_API_KEY=

# MongoDB Configuration
MONGO_URI=PASTE_YOUR_MONGODB_ATLAS_URI_HERE
MONGO_DB=opsagent

# Simulator
SIM_BACKEND_URL=http://localhost:8001

# Authentication
JWT_SECRET_KEY=GENERATE_YOUR_OWN_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD